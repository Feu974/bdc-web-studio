# ============================================================
# BDC Web Studio - Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ============================================================

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbG...your-anon-key

# Service Role (JAMAIS exposer cote client - Edge Functions uniquement)
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...your-service-role-key

# PDFMonkey (Generation devis/factures)
VITE_PDFMONKEY_API_KEY=your-pdfmonkey-api-key
VITE_PDFMONKEY_DEVIS_TEMPLATE_ID=your-template-id
VITE_PDFMONKEY_FACTURE_TEMPLATE_ID=your-facture-template-id
